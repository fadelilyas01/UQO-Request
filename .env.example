# =============================================================================
# Configuration d'environnement - Projet UQO-Requests
# Copier ce fichier vers '.env' et adapter les valeurs a votre deploiement.
# Ne jamais commiter de fichier '.env' dans le depot Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Configuration Backend (Django)
# -----------------------------------------------------------------------------
# Mode Debug (True en developpement local, False impératif en production)
DEBUG=True

# Cle secrete Django (A generer en production)
# Commande : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=votre-cle-secrete-aleatoire-a-generer

# Domaines autorises (separes par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# -----------------------------------------------------------------------------
# Base de donnees PostgreSQL
# -----------------------------------------------------------------------------
# Format : postgres://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BDD
DATABASE_URL=postgres://uqo_user:votre_mot_de_passe_robuste@db:5432/uqo_requests_db

# Parametres pour conteneur PostgreSQL (docker-compose)
POSTGRES_DB=uqo_requests_db
POSTGRES_USER=uqo_user
POSTGRES_PASSWORD=votre_mot_de_passe_robuste

# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# -----------------------------------------------------------------------------
# Duree de vie des jetons JWT (en minutes)
# -----------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1440

# -----------------------------------------------------------------------------
# Configuration Frontend (Vite / React)
# -----------------------------------------------------------------------------
# En dev local : http://localhost:8000/api
# En production Docker via Nginx : /api
VITE_API_URL=/api
