# =============================================================================
# Root .gitignore - Projet UQO-Requests
# =============================================================================

# Environnement et Secrets (NE JAMAIS COMMITER)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.env

# Environnements virtuels Python
venv/
.venv/
env/
ENV/
backend/venv/

# Caches et fichiers compiles Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
backend/media/
staticfiles/
backend/staticfiles/

# Node.js et Frontend
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Fichiers IDE
.vscode/
.idea/
*.swp
*.swo

# Fichiers OS
.DS_Store
Thumbs.db
